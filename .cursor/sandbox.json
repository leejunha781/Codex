{
  "type": "workspace_readwrite",
  "enableSharedBuildCache": true,
  "disableTmpWrite": false,
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "codeload.github.com",
      "cursor.com",
      "*.cursor.com",
      "downloads.cursor.com",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "npmjs.org",
      "npmjs.com",
      "pypi.org",
      "pypi.python.org",
      "files.pythonhosted.org",
      "pythonhosted.org",
      "pypa.io",
      "aka.ms",
      "*.microsoft.com",
      "learn.microsoft.com",
      "mcp.notion.com",
      "api.notion.com",
      "mcp.linear.app",
      "api.linear.app"
    ],
    "deny": [
      "169.254.169.254",
      "metadata.google.internal"
    ]
  }
}
